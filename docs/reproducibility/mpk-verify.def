# Apptainer definition: a CPU-only container that verifies every number the manuscript
# states directly from the committed result files (README, "Verify the reported numbers").
#
#   apptainer build --fakeroot mpk-verify.sif docs/reproducibility/mpk-verify.def
#   apptainer run --bind "$PWD":/opt/mpk mpk-verify.sif          # -> "FAILURES: none"
#
# The image pins the interpreter (Python 3.11) and the exact package versions of
# requirements.txt; torch and torchvision come from the CPU wheel index (the CUDA build
# of requirements.txt is needed for training only). numpy/scipy ship their own OpenBLAS
# (scipy-openblas 0.3.31 in the environment that produced the reported numbers,
# environment.lock.yml); the verification re-derives numbers from stored results and
# does not depend on the BLAS.
#
# To run the referee script (notebooks/readout_gain_torchvision.py) inside the container:
#   apptainer exec --bind "$PWD":/opt/mpk mpk-verify.sif \
#       bash -c 'cd /opt/mpk && PYTHONPATH=. python notebooks/readout_gain_torchvision.py'

Bootstrap: docker
From: python:3.11

%files
    requirements.txt /opt/requirements.txt

%post
    set -e
    # the full python:3.11 image already ships the VCS client and libgomp1; an apt step under fakeroot took > 2 h on a compute node
    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.13.0 torchvision==0.28.0
    grep -E '^(numpy|scipy|himalaya|scikit-learn|matplotlib|pandas|nibabel|h5py|pillow|colour-science|joblib|tqdm|kornia)==' /opt/requirements.txt > /opt/req-cpu.txt
    python -m pip install --no-cache-dir -r /opt/req-cpu.txt
    # KietzmannLab/DVD at the pinned commit: its nested package dvd_scale_free/dvd_scale_free has no
    # __init__.py, so a pip install drops it; the clone's root goes on PYTHONPATH instead (as locally)
    git clone -q https://github.com/KietzmannLab/DVD.git /opt/dvd && cd /opt/dvd && git checkout -q 36e56374bb73f52a97fc6e3a39531cba2443bb2f && cd /
    mkdir -p /opt/mpk /tmp/mpl

%environment
    export PYTHONPATH=/opt/mpk:/opt/mpk/tmp_analysis:/opt/dvd
    export MPLCONFIGDIR=/tmp/mpl
    export OMP_NUM_THREADS=4
    export PYTHONNOUSERSITE=1   # never pick up the host user's ~/.local site-packages (apptainer binds $HOME)

%runscript
    cd /opt/mpk && exec python tmp_analysis/verify_new_claims.py "$@"

%labels
    Project Magno-Parvo-Konio-Net
    Purpose verify_new_claims.py in a pinned CPU environment
